                  "value": "{{display_name}}",
                  "type": "text"
                },
                {
                  "key": "file",
                  "type": "file",
                  "src": "{{catalog_pdf_path}}"
                }
              ]
            },
            "url": "{{base_url}}/api/catalog/documents/{{document_id}}"
          }
