      "name": "Negative Checks",
      "item": [
        {
          "name": "Document Access Without Cookie Should Fail",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.cookies.jar().unset(pm.collectionVariables.get('base_url'), 'catalog_access');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('missing cookie is rejected', function () {",
                  "  pm.expect([401]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ],
